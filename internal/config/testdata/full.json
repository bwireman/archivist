{
  "ollama": {
    "base_url": "http://ollama.example:11434",
    "embed_model": "mxbai-embed-large",
    "embed_timeout": "5m"
  },
  "index": {
    "skip_dirs": [
      ".git",
      "vendor",
      "node_modules",
      ".archivist",
      "dist",
      "build"
    ],
    "skip_globs": [
      "*.min.js",
      "*.pb.go"
    ],
    "adr": {
      "repo": [
        "docs/decisions/**",
        "**/adr/**",
        "**/ADR*.md",
        "architecture/decisions/**"
      ],
      "global": [
        "docs/global-decisions/**",
        "architecture/global-decisions/**"
      ]
    }
  },
  "store": {
    "path": ".archivist/custom-index.db",
    "global_path": "custom-global.db"
  }
}
