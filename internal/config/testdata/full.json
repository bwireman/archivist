{
  "ollama": {
    "base_url": "http://ollama.example:11434",
    "embed_model": "mxbai-embed-large",
    "embed_timeout": "5m"
  },
  "index": {
    "skip_globs": [
      "*.min.js",
      "*.pb.go"
    ]
  },
  "records": {
    "repo": "docs/decisions",
    "global": "docs/global-decisions",
    "dev": "notes",
    "export": "docs/archive"
  },
  "publish": {
    "destinations": {
      "wiki": {
        "command": ["./scripts/push.sh", "{{bundle}}"]
      }
    }
  },
  "log_commands": true
}
