{
  "ollama": {
    "base_url": "http://localhost:11434",
    "embed_model": "qwen3-embedding:0.6b",
    "embed_timeout": "5m"
  },
  "index": {
    "skip_dirs": [
      ".git",
      "vendor",
      "node_modules",
      ".archivist"
    ],
    "skip_globs": [],
    "adr": {
      "repo": [
        "docs/decisions/**",
        "**/adr/**",
        "**/ADR*.md"
      ],
      "global": [
        "docs/global-decisions/**"
      ]
    }
  },
  "store": {
    "path": ".archivist/index.db"
  }
}
